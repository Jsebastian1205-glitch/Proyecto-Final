# =====================================================================
# BuildZone - variables de entorno para produccion (perfil prod)
# ---------------------------------------------------------------------
# Este archivo es solo una PLANTILLA: no tiene claves reales y se puede
# subir a GitHub. Las claves reales se escriben en el panel del hosting
# (Railway > servicio > Variables), NUNCA en un archivo del repositorio.
# Guia: docs/DESPLIEGUE.md
# =====================================================================

# Clave para firmar las sesiones (Base64, minimo 32 bytes).
# Generar (Git Bash):   openssl rand -base64 48
# o en PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RNGCryptoServiceProvider]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Administrador inicial (se crea la primera vez que arranca).
# Minimo 12 caracteres, con mayusculas, minusculas y numeros.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base de datos. En Railway se toman del servicio MySQL con referencias:
#   MYSQLHOST=${{MySQL.MYSQLHOST}}   MYSQLPORT=${{MySQL.MYSQLPORT}}
#   MYSQLDATABASE=${{MySQL.MYSQLDATABASE}}
#   MYSQLUSER=${{MySQL.MYSQLUSER}}   MYSQLPASSWORD=${{MySQL.MYSQLPASSWORD}}
# En otro hosting se puede usar una sola URL JDBC:
#   DB_URL=jdbc:mysql://host:3306/buildzone?sslMode=REQUIRED
#   DB_USER=
#   DB_PASSWORD=

# Opcional: dominios que pueden llamar a la API desde otro sitio (nunca *).
# Vacio = solo la propia pagina de BuildZone.
CORS_ORIGENES=
